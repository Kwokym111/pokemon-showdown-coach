# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.
# The app picks the AI provider like this: GEMINI_API_KEY set -> Google Gemini;
# otherwise AI_API_KEY + AI_ACCOUNT_ID set -> Cloudflare; otherwise no AI (review without words).

# Google Gemini (AI Studio key)
GEMINI_API_KEY=your-gemini-api-key
# Optional: models to try in order; if one fails or is busy the next is used.
# Leave empty for the default: gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODELS=
# Optional: minimal | low | medium | high. Less thinking = faster replies. Empty = model default.
GEMINI_THINKING=

# Cloudflare Workers AI (used only when GEMINI_API_KEY is empty)
AI_API_KEY=your-cloudflare-api-token
AI_ACCOUNT_ID=your-cloudflare-account-id
# Optional: a different Workers AI model. Leave empty for the default in ai.js.
AI_MODEL=
