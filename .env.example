# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.
# Cloudflare Workers AI (the provider ai.js currently uses).
AI_API_KEY=your-cloudflare-api-token
AI_ACCOUNT_ID=your-cloudflare-account-id
# Optional: a different Workers AI model. Leave empty for the default in ai.js.
AI_MODEL=
